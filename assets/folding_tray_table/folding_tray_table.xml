<mujoco model="folding_tray_table">
  <!-- Mainstays Indoor Single Folding TV Tray Table (eBay listing: 19 x 15 x 26 in = 48.3 x 38.1 x 66 cm), matches the user's measurement 48 x 37 x 65 cm, which is used -->
  <compiler meshdir="."/>
  <default>
    <default class="folding_tray_table_visual">
      <geom type="mesh" contype="0" conaffinity="0" group="2"/>
    </default>
    <default class="folding_tray_table_collision">
      <geom type="mesh" group="3" condim="4" friction="0.5 0.005 0.0001"/>
    </default>
  </default>
  <asset>
    <mesh name="folding_tray_table_visual" file="folding_tray_table_visual.obj"/>
